# =====================================================================
# AI Employees SaaS — environment configuration
# Copy to `.env.local` for local dev, or set in your host for production.
# NEVER commit a real .env.local. The app MUST fail closed when required
# server secrets are missing (see lib/config.ts).
# =====================================================================

# ---- App --------------------------------------------------------------
APP_URL=http://localhost:3000
# Secret used to sign local-development session tokens and CSRF values.
# Generate a strong value (e.g. `openssl rand -hex 32`). Required in prod.
APP_SECRET=dev-only-insecure-change-me

# ---- Database driver --------------------------------------------------
# `local`  -> in-process Postgres via pglite (no external services needed).
#             Great for local dev and CI. Optionally persisted to PGLITE_DIR.
# `supabase` -> real Supabase Postgres + RLS (production).
DATABASE_DRIVER=local
# Optional on-disk location for the local pglite database (empty = in-memory).
PGLITE_DIR=

# ---- Supabase (production auth + data + storage) -----------------------
# Leave blank for local dev (the app uses its built-in local auth + storage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the browser. Used for migrations, RLS bypass
# where required, and Storage admin. If you set DATABASE_DRIVER=supabase you
# must provide this.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Model gateway ----------------------------------------------------
# Provider for the server-side model gateway. Tenant API keys are NOT used;
# the platform owns model access and bills customers.
#   mock                -> deterministic offline provider (no key needed).
#   openai-compatible   -> OpenAI-compatible HTTP API (DeepSeek, OpenAI, etc.)
MODEL_PROVIDER=mock
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
# Default model ref used when an employee has no model override.
MODEL_GATEWAY_DEFAULT_MODEL=
# Optional override of per-token cost (USD) when the provider does not return
# cost; documents cost instead of fabricating it. Format: model=in,out
MODEL_COST_OVERRIDES=
# Request timeout (ms) for a single model call.
MODEL_REQUEST_TIMEOUT_MS=120000

# ---- Worker -----------------------------------------------------------
# How many tasks the worker runs concurrently (per process).
WORKER_CONCURRENCY=4
# Hard cap on a single task's wall-clock runtime (ms). Tasks are killed at this.
TASK_MAX_DURATION_MS=600000
# Max tool calls a single task may make before it is halted.
TASK_MAX_TOOL_CALLS=30
# How often (ms) the worker polls the queue for new work.
WORKER_POLL_MS=2000
# Run the worker inside the web server process. Default: on for the local
# (pglite) driver, whose embedded database cannot be shared with a separate
# process; off for Supabase, where you run `npm run worker` instead.
WORKER_INLINE=

# ---- Billing (Paystack) ----------------------------------------------
# Billing is DISABLED automatically when these are blank. The app never
# simulates a successful payment; checkout requires real configuration.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Set to `true` only when keys above are real and verified.
BILLING_ENABLED=false

# ---- Limits / defaults ------------------------------------------------
# Soft monthly model-spend cap (USD) applied per organization until the plan
# says otherwise. Enforced server-side before and during work.
DEFAULT_ORG_SPEND_LIMIT_USD=10
